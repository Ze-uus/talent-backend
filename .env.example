# =============================================================================
# Scaloo Backend — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# =============================================================================

# === Required ================================================================

# Postgres connection string (NeonDB or local)
DATABASE_URL=postgres://user:password@localhost:5432/scaloo?sslmode=disable

# Application secret — used for signing tokens and cookies (min 32 chars)
APP_KEY=change-me-to-a-random-32-char-string

# === Optional (defaults shown) ===============================================

# HTTP listen port
PORT=8080

# Environment: "development" or "production"
APP_ENV=development

# Semver version — injected at build time via ldflags, fallback here
APP_VERSION=0.1.0

# Frontend base URL — used for links in lifecycle emails
APP_URL=http://localhost:3000

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Global rate limit: requests per second per IP
RATE_LIMIT_RPS=100

# Long-term Bayesian decay rate for talent baselines
DELTA_LT=0.97

# === Mail =====================================================================
# Selection: RESEND_API_KEY → Resend HTTP API; else SMTP_HOST → SMTP; else NopMailer.
# Local: Mailpit via docker compose (UI: http://localhost:8025).
# Prod: set RESEND_API_KEY and verify the SMTP_FROM domain in Resend.

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Scaloo <noreply@scaloo.local>
SMTP_TLS=false

# Production (Render): leave SMTP_HOST empty and set:
# RESEND_API_KEY=re_...
# SMTP_FROM=Scaloo <reward@usescaloo.com>
# APP_URL=https://app.usescaloo.com
RESEND_API_KEY=

# === ImageKit (server-side image uploads) =====================================
# Leave IMAGEKIT_PRIVATE_KEY empty to disable uploads (API returns imagekit_not_configured).
# Folders: /scaloo/brands/{brand_id}, /scaloo/avatars/{user_id}

IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# === Google OAuth (required for talent Google sign-in) =======================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/v1/auth/google/callback

# === Audit (append-only log + immutable archive) ==============================
# HMAC secret for entry signatures (defaults to APP_KEY when empty)
AUDIT_HMAC_SECRET=

# Local filesystem archive when AUDIT_S3_BUCKET is empty
AUDIT_ARCHIVE_DIR=./var/audit

# Optional S3-compatible archive (R2 / MinIO / S3). Prefer Object Lock + no-delete IAM in production.
AUDIT_S3_ENDPOINT=
AUDIT_S3_BUCKET=
AUDIT_S3_REGION=auto
AUDIT_S3_ACCESS_KEY=
AUDIT_S3_SECRET_KEY=
