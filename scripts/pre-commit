#!/usr/bin/env bash
set -e

# Ensure Go-installed tools (golangci-lint, goose, etc.) are on the PATH.
export PATH="$PATH:$(go env GOPATH)/bin"

echo "→ pre-commit: go mod tidy check"
go mod tidy
git diff --exit-code go.mod go.sum

echo "→ pre-commit: go vet"
go vet ./...

echo "→ pre-commit: golangci-lint"
golangci-lint run ./... --timeout=3m

echo "→ pre-commit: unit tests"
go test ./... -count=1 -race -timeout=60s

echo "✓ all checks passed"
